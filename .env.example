# Environment Configuration Template
# Copy this file to .env and fill in your values
# IMPORTANT: Never commit .env file with secrets!

# Firebase Configuration
# Get these values from Firebase Console > Project Settings
FIREBASE_PROJECT_ID=nexora-bvc
FIREBASE_API_KEY=YOUR_WEB_API_KEY
FIREBASE_AUTH_DOMAIN=nexora-bvc.firebaseapp.com
FIREBASE_DATABASE_URL=https://nexora-bvc.firebaseio.com
FIREBASE_STORAGE_BUCKET=nexora-bvc.appspot.com
FIREBASE_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID
FIREBASE_APP_ID=YOUR_APP_ID

# Cloudflare Worker Configuration
CLOUDFLARE_WORKER_URL=https://api.nexora.ai
CLOUDFLARE_API_TOKEN=YOUR_CLOUDFLARE_API_TOKEN

# AI Provider Configuration
# Choose one provider and configure:
# - Google Gemini
# - OpenRouter
# - Cloudflare AI

AI_PROVIDER=cloudflare  # Options: gemini, openrouter, cloudflare
AI_PROVIDER_KEY=YOUR_AI_PROVIDER_KEY

# Google Sign-In
# Get from Google Cloud Console
GOOGLE_WEB_CLIENT_ID=YOUR_GOOGLE_WEB_CLIENT_ID
GOOGLE_IOS_CLIENT_ID=YOUR_GOOGLE_IOS_CLIENT_ID
GOOGLE_ANDROID_CLIENT_ID=YOUR_GOOGLE_ANDROID_CLIENT_ID

# Application Configuration
APP_ENVIRONMENT=development  # Options: development, staging, production
APP_DEBUG_MODE=true
APP_LOG_LEVEL=debug  # Options: debug, info, warning, error

# API Configuration
API_TIMEOUT_SECONDS=30
API_MAX_RETRIES=3
API_BASE_URL=https://api.nexora.ai

# Database Configuration
FIRESTORE_COLLECTION_USERS=users
FIRESTORE_COLLECTION_CHATS=chats
FIRESTORE_COLLECTION_MESSAGES=messages
FIRESTORE_COLLECTION_KNOWLEDGE=knowledge_documents
FIRESTORE_COLLECTION_ADMIN=admin_config

# Storage Configuration
FIREBASE_STORAGE_PROFILE_IMAGES_PATH=profile-images/
FIREBASE_STORAGE_DOCUMENTS_PATH=documents/
FIREBASE_STORAGE_MAX_FILE_SIZE=10485760  # 10MB in bytes

# Feature Flags
FEATURE_CHAT_HISTORY=true
FEATURE_PINNED_CHATS=true
FEATURE_RAG_SEARCH=false  # Coming in Phase 7
FEATURE_ADMIN_PANEL=false  # Coming later
FEATURE_OFFLINE_MODE=false  # Coming later

# Analytics
ANALYTICS_ENABLED=true
ANALYTICS_DEBUG_MODE=false

# Security
SESSION_TIMEOUT_MINUTES=30
PASSWORD_MIN_LENGTH=8
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# Email Configuration (for password reset, notifications)
# Will be handled by Firebase by default
SEND_GRID_API_KEY=YOUR_SENDGRID_API_KEY  # Optional

# Mobile-Specific
ANDROID_APP_ID=com.bvccollege.nexora
IOS_APP_ID=com.bvccollege.nexora
APP_STORE_URL=https://apps.apple.com/app/nexora/XXXXXXXXX
PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.bvccollege.nexora
